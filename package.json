{
  "name": "nixelune",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource-variable/inter": "5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
